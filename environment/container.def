Bootstrap: docker
From: nvidia/cuda:12.1.0-runtime-ubuntu22.04

%post
    apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-dev python3-venv \
        tmux nano vim-tiny less curl wget git \
        libopenmpi-dev openmpi-bin \
        && ln -sf /usr/bin/python3 /usr/bin/python \
        && rm -rf /var/lib/apt/lists/*

    mkdir -p /home/user/data
    chmod 755 /home/user


    # --- Merged from setup.sh ---
    pip install --break-system-packages uv 2>/dev/null || pip install uv 2>/dev/null || true
    export UV_SYSTEM_PYTHON=1 UV_BREAK_SYSTEM_PACKAGES=1
    # Install Python packages into the container overlay.
    #
    # This script runs inside the container with internet access.
    # Use uv pip install --system for speed.
    
    set -e
    
    # Core scientific computing packages
    uv pip install --system \
        numpy \
        scipy \
        scikit-learn \
        pandas \
        matplotlib \
        seaborn

%environment
    export HOME=/home/user
    export PYTHONUNBUFFERED=1
    export CUDA_VISIBLE_DEVICES=""
